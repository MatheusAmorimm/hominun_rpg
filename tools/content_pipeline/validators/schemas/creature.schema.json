{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creature",
  "title": "DemonSpecies",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","name","level","description","rarity","temperament_base",
               "temperament_variants","base_stats","abilities","habitat",
               "capture_difficulty","lore"],
  "properties": {
    "id":          { "type": "string", "minLength": 1 },
    "name":        { "type": "string", "minLength": 1 },
    "level":       { "type": "integer", "minimum": 1, "maximum": 20 },
    "description": { "type": "string" },
    "rarity": {
      "type": "string",
      "enum": ["common","uncommon","rare","very_rare","legendary"]
    },
    "temperament_base": {
      "type": "string",
      "enum": ["aggressive","protective","cautious","territorial","cruel",
               "loyal","unpredictable","noble","solitary","social"]
    },
    "temperament_variants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["aggressive","protective","cautious","territorial","cruel",
                 "loyal","unpredictable","noble","solitary","social"]
      },
      "minItems": 1,
      "description": "Temperamentos possíveis para indivíduos dessa espécie."
    },
    "base_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp","mana","strength","agility","armor"],
      "properties": {
        "hp":       { "type": "integer", "minimum": 1 },
        "mana":     { "type": "integer", "minimum": 0 },
        "strength": { "type": "integer", "minimum": 1 },
        "agility":  { "type": "integer", "minimum": 1 },
        "armor":    { "type": "integer", "minimum": 0 }
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","name","type","effect_type","description"],
        "properties": {
          "id":          { "type": "string" },
          "name":        { "type": "string" },
          "type":        { "type": "string", "enum": ["active","passive","reaction"] },
          "effect_type": {
            "type": "string",
            "enum": ["damage_physical","damage_fire","damage_electric","damage_ice",
                     "damage_venom","paralysis","freeze","blind","silk","heal",
                     "camouflage","scout","swarm"]
          },
          "description": { "type": "string" }
        }
      }
    },
    "habitat": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Zonas do Éter onde a espécie é encontrada."
    },
    "capture_difficulty": {
      "type": "string",
      "enum": ["trivial","easy","moderate","hard","extreme","legendary"]
    },
    "known_summoners": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Invocadores históricos conhecidos — referência de lore apenas."
    },
    "lore": { "type": "string", "minLength": 1 }
  }
}

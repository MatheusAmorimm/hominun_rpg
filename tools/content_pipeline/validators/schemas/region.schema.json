{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "region",
  "title": "Region",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "type", "danger_level", "available_in_acts", "connected_regions", "lore"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["urban", "rural", "wilderness", "ether", "frontier"]
    },
    "danger_level": {
      "type": "string",
      "enum": ["safe", "low", "medium", "high", "extreme"]
    },
    "available_in_acts": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 4 },
      "minItems": 0,
      "uniqueItems": true
    },
    "connected_regions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "IDs das regiões alcançáveis diretamente a partir desta."
    },
    "npcs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs dos NPCs presentes nessa região."
    },
    "quests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs das quests disponíveis nessa região."
    },
    "scene_image": {
      "type": "string",
      "description": "Caminho do asset de cena no assets_manifest.json."
    },
    "music_track": {
      "type": "string",
      "description": "ID da trilha ambiente no assets_manifest.json."
    },
    "narrative_flags_required": {
      "type": "object",
      "additionalProperties": true,
      "description": "Flags que o jogador precisa ter para acessar essa região."
    },
    "special_properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Propriedades únicas da região (ex: atmosfera tóxica do Éter, cidade-prisão)."
    },
    "lore": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "race",
  "title": "Race",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "stat_modifiers", "flexible_points", "derived_bonuses", "narrative_effects", "lore"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "stat_modifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer" },
        "dex": { "type": "integer" },
        "con": { "type": "integer" },
        "int": { "type": "integer" },
        "wis": { "type": "integer" },
        "cha": { "type": "integer" }
      }
    },
    "flexible_points": {
      "type": "integer",
      "minimum": 0,
      "description": "Pontos livres para distribuir (1 por stat). Exclusivo de Humanos."
    },
    "derived_bonuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp_bonus", "mana_bonus", "initial_affinity_bonus"],
      "properties": {
        "hp_bonus": { "type": "integer" },
        "mana_bonus": { "type": "integer" },
        "initial_affinity_bonus": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "narrative_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["price_markup", "social_persecution", "mission_locked", "dialogue_variant", "early_rival"]
          },
          "value": {}
        }
      }
    },
    "lore": { "type": "string", "minLength": 1 }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "origin",
  "title": "Origin",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "initial_flags", "narrative_effects", "lore"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "initial_flags": {
      "type": "object",
      "description": "Flags narrativas definidas desde a criação do personagem.",
      "additionalProperties": true
    },
    "narrative_effects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs de efeitos narrativos ativados por essa origem."
    },
    "lore": { "type": "string", "minLength": 1 }
  }
}

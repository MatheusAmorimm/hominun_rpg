{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "character",
  "title": "Character",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "race_id", "archetype_id", "origin_id", "base_stats", "save_version"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "race_id": { "type": "string", "enum": ["human", "elf", "dwarf", "orc"] },
    "archetype_id": { "type": "string", "enum": ["pure_summoner", "battle_mage", "ether_explorer"] },
    "origin_id": { "type": "string", "enum": ["noble", "commoner", "war_orphan"] },
    "base_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer", "minimum": 1, "maximum": 20 },
        "dex": { "type": "integer", "minimum": 1, "maximum": 20 },
        "con": { "type": "integer", "minimum": 1, "maximum": 20 },
        "int": { "type": "integer", "minimum": 1, "maximum": 20 },
        "wis": { "type": "integer", "minimum": 1, "maximum": 20 },
        "cha": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "flexible_points_used": {
      "type": "object",
      "description": "Somente Humanos. Distribuição dos 2 pontos livres (máx 1 por stat).",
      "additionalProperties": false,
      "properties": {
        "str": { "type": "integer", "minimum": 0, "maximum": 1 },
        "dex": { "type": "integer", "minimum": 0, "maximum": 1 },
        "con": { "type": "integer", "minimum": 0, "maximum": 1 },
        "int": { "type": "integer", "minimum": 0, "maximum": 1 },
        "wis": { "type": "integer", "minimum": 0, "maximum": 1 },
        "cha": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "narrative_flags": {
      "type": "object",
      "additionalProperties": true,
      "description": "Estado narrativo persistente do personagem."
    },
    "active_demon_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "maxItems": 10,
      "description": "IDs dos demônios vinculados. Nível do invocador = soma dos níveis desses demônios."
    },
    "save_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Versão do schema de save. Usada pelo version_registry para migrações."
    }
  }
}
